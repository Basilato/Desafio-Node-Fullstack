# ================================================================
# BACKEND - Variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores
# ================================================================

# --- Supabase / PostgreSQL ---
# Cole a "Project URL" e a "service_role" key do Supabase dashboard
DATABASE_URL="postgresql://postgres:<SENHA>@<HOST>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<SENHA>@<HOST>:5432/postgres"

# --- NestJS App ---
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# --- Autenticação JWT ---
JWT_SECRET="troque_essa_chave_por_uma_string_segura_ex:openssl rand -hex 32"
JWT_EXPIRES_IN="7d"

# --- Bcrypt ---
BCRYPT_ROUNDS=10

# --- Logs (pino) ---
LOG_LEVEL="debug"
